# NO CAP AI Verification Configuration
# The browser must NEVER contain private AI credentials.
# Set these on your local environment (.env) or in Vercel Project Settings -> Environment Variables.

# Required: OpenRouter API key for server-side verification
OPENROUTER_API_KEY=

# Primary reasoning model for NO CAP claim verification
OPENROUTER_MAIN_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Fast/backup model for fallback routing when the primary model is busy/rate-limited
OPENROUTER_FAST_MODEL=

# Enable/disable live internet verification for time-sensitive breaking claims (true/false)
OPENROUTER_WEB_SEARCH_ENABLED=true

# Maximum number of live web search results to examine per query (1-10)
OPENROUTER_WEB_SEARCH_MAX_RESULTS=5

# Optional: Public site URL and app title for OpenRouter rankings/dashboards
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=NO CAP
